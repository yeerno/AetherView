<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AetherView.App.Features.Home.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:home="clr-namespace:AetherView.App.Features.Home"
    x:DataType="home:HomeViewModel"
    Shell.NavBarIsVisible="False"
    Title="Start">

    <ContentPage.Resources>
        <Style x:Key="EyebrowLabelStyle" TargetType="Label">
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CharacterSpacing" Value="1.4" />
            <Setter
                Property="TextColor"
                Value="{AppThemeBinding Light=#3C6F74, Dark=#8FC5C4}" />
        </Style>

        <Style x:Key="CardTitleStyle" TargetType="Label">
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="18" />
            <Setter
                Property="TextColor"
                Value="{AppThemeBinding Light=#183438, Dark=#F2FAF9}" />
        </Style>

        <Style x:Key="MutedLabelStyle" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter
                Property="TextColor"
                Value="{AppThemeBinding Light=#597174, Dark=#A9BEBC}" />
        </Style>
    </ContentPage.Resources>

    <RefreshView
        Command="{Binding LoadCommand}"
        IsRefreshing="{Binding IsBusy, Mode=OneWay}">
        <CollectionView
            ItemsSource="{Binding RecentSessions}"
            SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout
                    Orientation="Vertical"
                    ItemSpacing="0" />
            </CollectionView.ItemsLayout>

            <CollectionView.Header>
                <VerticalStackLayout
                    Padding="24,28,24,18"
                    Spacing="20"
                    MaximumWidthRequest="920"
                    HorizontalOptions="Fill">
                    <Border Style="{StaticResource PreviewBadge}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Label Style="{StaticResource PreviewBadgeLabel}" />
                    </Border>
                    <Border
                        Padding="24"
                        BackgroundColor="{AppThemeBinding Light=#E8F4F2, Dark=#15363B}"
                        Stroke="{AppThemeBinding Light=#C7E0DC, Dark=#28535A}"
                        StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24" />
                        </Border.StrokeShape>

                        <Grid
                            RowDefinitions="Auto,Auto,Auto"
                            RowSpacing="8">
                            <Label
                                Grid.Row="0"
                                Text="AETHER VIEW"
                                Style="{StaticResource EyebrowLabelStyle}" />
                            <Label
                                Grid.Row="1"
                                Text="Witaj ponownie"
                                FontAttributes="Bold"
                                FontSize="30"
                                TextColor="{AppThemeBinding Light=#102F34, Dark=#F4FBFA}"
                                SemanticProperties.HeadingLevel="Level1" />
                            <Label
                                Grid.Row="2"
                                Text="Wróć do ostatnich sesji i spokojnie kontynuuj swój protokół."
                                FontSize="15"
                                LineHeight="1.25"
                                TextColor="{AppThemeBinding Light=#3E6164, Dark=#BDD0CE}" />
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout
                            Grid.Column="0"
                            Spacing="3">
                            <Label
                                Text="OSTATNIE SESJE"
                                Style="{StaticResource EyebrowLabelStyle}" />
                            <Label
                                Text="Ostatnia aktywność"
                                FontAttributes="Bold"
                                FontSize="24"
                                SemanticProperties.HeadingLevel="Level2" />
                        </VerticalStackLayout>
                        <Border
                            Grid.Column="1"
                            Padding="10,5"
                            VerticalOptions="End"
                            BackgroundColor="{AppThemeBinding Light=#F0F4F3, Dark=#25383A}"
                            StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Label
                                Text="do 5 sesji"
                                Style="{StaticResource MutedLabelStyle}" />
                        </Border>
                    </Grid>

                    <Border
                        Padding="14,10"
                        IsVisible="{Binding HasError}"
                        BackgroundColor="{AppThemeBinding Light=#FFF1ED, Dark=#4A2923}"
                        Stroke="{AppThemeBinding Light=#F5C8BB, Dark=#78483E}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Label
                            Text="{Binding ErrorMessage}"
                            FontSize="13"
                            TextColor="{AppThemeBinding Light=#8C3022, Dark=#FFD4C8}"
                            SemanticProperties.Description="{Binding ErrorMessage}" />
                    </Border>
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="home:RecentSessionItemViewModel">
                    <Border
                        Margin="24,0,24,12"
                        Padding="18"
                        MaximumWidthRequest="872"
                        HorizontalOptions="Fill"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#202B2D}"
                        Stroke="{AppThemeBinding Light=#DCE6E4, Dark=#36484B}"
                        StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>

                        <Grid
                            RowDefinitions="Auto,Auto,Auto"
                            ColumnDefinitions="*,Auto"
                            RowSpacing="8"
                            ColumnSpacing="12">
                            <Label
                                Grid.Row="0"
                                Grid.Column="0"
                                Text="{Binding Name}"
                                Style="{StaticResource CardTitleStyle}"
                                LineBreakMode="TailTruncation"
                                SemanticProperties.HeadingLevel="Level3" />
                            <Border
                                Grid.Row="0"
                                Grid.Column="1"
                                Padding="9,4"
                                BackgroundColor="{AppThemeBinding Light=#E8F4F2, Dark=#23464B}"
                                StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Label
                                    Text="{Binding Status}"
                                    FontAttributes="Bold"
                                    FontSize="11"
                                    TextColor="{AppThemeBinding Light=#32666A, Dark=#A7D5D2}" />
                            </Border>
                            <Label
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Text="{Binding Question}"
                                FontSize="14"
                                LineBreakMode="TailTruncation"
                                MaxLines="2"
                                TextColor="{AppThemeBinding Light=#395154, Dark=#CBD8D7}" />
                            <Label
                                Grid.Row="2"
                                Grid.ColumnSpan="2"
                                Text="{Binding EventTime}"
                                Style="{StaticResource MutedLabelStyle}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <VerticalStackLayout
                    Margin="24,6,24,32"
                    MaximumWidthRequest="872"
                    HorizontalOptions="Fill">
                    <Border
                        Padding="24"
                        BackgroundColor="{AppThemeBinding Light=#F7F9F8, Dark=#202A2C}"
                        Stroke="{AppThemeBinding Light=#DDE6E4, Dark=#344447}"
                        StrokeDashArray="5,4">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>
                        <VerticalStackLayout
                            Spacing="8"
                            HorizontalOptions="Center">
                            <Label
                                Text="Brak ostatnich sesji"
                                Style="{StaticResource CardTitleStyle}"
                                HorizontalTextAlignment="Center"
                                SemanticProperties.HeadingLevel="Level3" />
                            <Label
                                Text="Gdy utworzysz pierwszy projekt, pojawi się tutaj jego skrót."
                                Style="{StaticResource MutedLabelStyle}"
                                HorizontalTextAlignment="Center"
                                MaximumWidthRequest="420" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.Footer>
                <BoxView
                    HeightRequest="20"
                    Opacity="0" />
            </CollectionView.Footer>
        </CollectionView>
    </RefreshView>
</ContentPage>
